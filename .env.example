# ---------------------------------------------------------------------------
# Heliograph platform — environment template
#
# Copy to .env for local development and fill in. .env is git-ignored;
# never commit real credentials. On Railway these are set as service
# variables, not as a file.
# ---------------------------------------------------------------------------

# --- Django ----------------------------------------------------------------
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Use that rather than Django's get_random_secret_key(): its alphabet
# includes "$", and Docker Compose interpolates "$" when it reads this
# file — a key containing one is silently mangled, so the container ends
# up with a different SECRET_KEY than the host. If a value here must
# contain a literal "$", write it as "$$".
DJANGO_SECRET_KEY=replace-me
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO

# Moves the Django admin off the default path. Must end with a slash.
DJANGO_ADMIN_URL=admin/

# --- Database --------------------------------------------------------------
# Railway injects DATABASE_URL automatically for a Postgres service.
DATABASE_URL=postgres://heliograph:heliograph@127.0.0.1:5432/heliograph
DJANGO_CONN_MAX_AGE=60

# --- Media -----------------------------------------------------------------
# local | cloudinary
MEDIA_BACKEND=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=heliograph

# --- Integrations -----------------------------------------------------------
# Encrypts access_token/refresh_token/client_secret on IntegrationConnection
# before they reach PostgreSQL. Required wherever a real provider credential
# is ever entered. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave blank only in development with no real provider connected — a key
# derived from DJANGO_SECRET_KEY is used instead, which must never be relied
# on once a real token exists.
FIELD_ENCRYPTION_KEY=

# --- Accounts --------------------------------------------------------------
# How a self-registered client account starts life.
#   approval — PENDING until a staff member approves it (default, safer)
#   auto     — ACTIVE immediately
# There is no email verification in this version, so "auto" means any
# address typed into the form gets a live account.
ACCOUNTS_REGISTRATION_MODE=approval

# Whether X-Forwarded-For may be believed when identifying a caller for
# rate limiting. False locally; true behind Railway's edge.
DJANGO_TRUST_PROXY_HEADERS=False

# --- Site / brand ----------------------------------------------------------
SITE_NAME=Heliograph
SITE_TAGLINE=Digital marketing agency
SITE_CONTACT_EMAIL=hello@heliograph.agency
SITE_DEFAULT_CURRENCY=USD

# --- Development only ------------------------------------------------------
DJANGO_DEBUG_TOOLBAR=False

# --- Production only -------------------------------------------------------
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SESSION_COOKIE_AGE=43200

# ---------------------------------------------------------------------------
# Deliberately absent: Redis, Celery broker, SMTP / email provider, SMS and
# WhatsApp credentials. This version sends nothing outbound — every message
# is persisted and surfaced in the in-app Inbox and Notification Center.
# ---------------------------------------------------------------------------
