# Build context hygiene — keep the image small and free of host state.
venv/
.venv/
node_modules/
staticfiles/
mediafiles/
.git/
.gitignore
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
db.sqlite3
*.log

# Reference material, not source.
*.pdf

# Secrets never go into an image layer. Configuration is supplied at run
# time by compose (or by Railway service variables in production).
.env
.env.*
!.env.example
